# GNS3 MCP 连接配置 —— 复制本文件为 .env 并填入真实值
# （.env 已被 .gitignore 忽略，不要提交真实 token）

# GNS3 服务器 MCP 的 SSE 端点（Claude Code 用同一个地址；本机服务器用 127.0.0.1）
GNS3_MCP_URL=http://127.0.0.1:3080/v3/mcp/transport/sse

# GNS3 MCP 的 Bearer token（在 GNS3 Web UI 用户设置里生成）
GNS3_MCP_TOKEN=gns3_xxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
